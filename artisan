function runResetPassword(string $email, string $newPassword): void {
    echo "\n\033[1;34m=== Reset Password Pengguna ===\033[0m\n\n";

    try {
        $db = getDB();
    } catch (\Throwable $e) {
        printError("Gagal terhubung ke database: " . $e->getMessage());
        exit(1);
    }

    $hash = password_hash($newPassword, PASSWORD_BCRYPT);

    $st = $db->prepare("SELECT id, email, full_name FROM users WHERE email = ? LIMIT 1");
    $st->execute([$email]);
    $user = $st->fetch();

    if ($user) {
        $up = $db->prepare("UPDATE users SET encrypted_password = ?, updated_at = NOW() WHERE id = ?");
        $up->execute([$hash, $user['id']]);

        printSuccess("Password untuk akun '{$email}' ({$user['full_name']}) berhasil direset!");
    } else {
        $userId = uuid4();
        $ins = $db->prepare("INSERT INTO users (id, email, encrypted_password, full_name, email_confirmed_at, created_at, updated_at) VALUES (?, ?, ?, ?, NOW(), NOW(), NOW())");
        $ins->execute([$userId, $email, $hash, 'Pengguna']);

        $db->prepare("INSERT INTO profiles (id, full_name, instansi, bio, created_at, updated_at) VALUES (?, ?, ?, ?, NOW(), NOW())")
           ->execute([$userId, 'Pengguna', 'BTIKP Sulawesi Tenggara', 'Pengguna Sistem Media Belajar']);

        $db->prepare("INSERT INTO user_roles (id, user_id, role, created_at) VALUES (?, ?, 'kontributor', NOW())")
           ->execute([uuid4(), $userId]);

        printSuccess("Akun baru '{$email}' berhasil dibuat!");
    }

    echo "\n\033[1mKredensial Login Sekarang:\033[0m\n";
    echo "  Email    : \033[36m{$email}\033[0m\n";
    echo "  Password : \033[36m{$newPassword}\033[0m\n\n";
}

