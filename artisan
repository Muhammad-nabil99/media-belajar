#!/usr/bin/env php
<?php
/**
 * Artisan CLI Helper for Media Belajar BTIKP Sulawesi Tenggara
 * Menyediakan perintah CLI praktis untuk migrasi & seeding database pada environment Docker.
 *
 * Penggunaan:
 *   php artisan migrate
 *   php artisan db:seed
 *   php artisan migrate:status
 */

declare(strict_types=1);

// Pastikan dijalankan melalui CLI
if (php_sapi_name() !== 'cli') {
    die("Hanya dapat dijalankan melalui terminal (CLI).\n");
}

require_once __DIR__ . '/api/config.php';
require_once __DIR__ . '/api/registration_helper.php';

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'migrate':
        runMigrate();
        break;
    case 'db:seed':
        runSeed();
        break;
    case 'migrate:status':
        runStatus();
        break;
    case 'auth:defaults':
    case 'reset:defaults':
    case 'reset:admin':
        runAuthDefaults();
        break;
    case 'user:password':
        runResetPassword($argv[2] ?? 'admin@btikpsultra.com', $argv[3] ?? 'admin123');
        break;
    case 'help':
    default:
        showHelp();
        break;
}

function printSuccess(string $msg): void {
    echo "\033[32m✔ " . $msg . "\033[0m\n";
}

function printInfo(string $msg): void {
    echo "\033[36mℹ " . $msg . "\033[0m\n";
}

function printWarn(string $msg): void {
    echo "\033[33m⚠ " . $msg . "\033[0m\n";
}

function printError(string $msg): void {
    echo "\033[31m✖ " . $msg . "\033[0m\n";
}

function runMigrate(): void {
