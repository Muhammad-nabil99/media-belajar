    }

    echo "\n\033[32m✔ Seeding database selesai!\033[0m\n\n";
    echo "=========================================================\n";
    echo "\033[1mKREDENSIAL DEFAULT UNTUK MASUK (LOGIN):\033[0m\n";
    echo "1. Administrator:\n";
    echo "   - Email    : admin@btikpsultra.com\n";
    echo "   - Password : admin123\n";
    echo "2. Reviewer:\n";
    echo "   - Email    : reviewer@btikpsultra.com\n";
    echo "   - Password : reviewer123\n";
    echo "3. Kontributor (Guru):\n";
    echo "   - Email    : guru@btikpsultra.com\n";
    echo "   - Password : guru123\n";
    echo "=========================================================\n\n";
}

function runStatus(): void {
    echo "\n\033[1;34m=== Status Database Media Belajar ===\033[0m\n\n";

    try {
        $db = getDB();
    } catch (\Throwable $e) {
        printError("Gagal terhubung ke database: " . $e->getMessage());
        exit(1);
    }

    $checkTables = ['users', 'profiles', 'user_roles', 'media', 'mata_pelajaran', 'kompetensi_keahlian', 'site_settings', 'registration_audit_logs'];

    foreach ($checkTables as $t) {
        try {
            $c = $db->query("SELECT COUNT(*) FROM `$t`")->fetchColumn();
            printSuccess("Tabel `$t`: OK ($c baris)");
        } catch (\Exception $e) {
            printWarn("Tabel `$t`: Belum ada (" . $e->getMessage() . ")");
        }
    }
    echo "\n";
}

