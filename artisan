            ['jenjang' => 'SMP', 'nama' => 'IPS Terpadu', 'urutan' => 4],
            ['jenjang' => 'SMA', 'nama' => 'Fisika', 'urutan' => 1],
            ['jenjang' => 'SMA', 'nama' => 'Kimia', 'urutan' => 2],
            ['jenjang' => 'SMA', 'nama' => 'Biologi', 'urutan' => 3],
            ['jenjang' => 'SMA', 'nama' => 'Ekonomi', 'urutan' => 4],
            ['jenjang' => 'SMK', 'nama' => 'Dasar Program Keahlian', 'urutan' => 1],
            ['jenjang' => 'SMK', 'nama' => 'Konsentrasi Keahlian', 'urutan' => 2],
            ['jenjang' => 'SMK', 'nama' => 'Projek Kreatif dan Kewirausahaan', 'urutan' => 3],
        ];

        $stMapel = $db->prepare("INSERT INTO mata_pelajaran (jenjang, nama, urutan) VALUES (?, ?, ?)");
        foreach ($mapels as $m) {
            $stMapel->execute([$m['jenjang'], $m['nama'], $m['urutan']]);
        }
        printSuccess("Berhasil menyemai data master Mata Pelajaran.");
    } else {
        printInfo("Data master Mata Pelajaran sudah ada ($countMapel baris).");
    }

    // 3. Seed Data Kompetensi Keahlian SMK
    $countKomp = (int)$db->query("SELECT COUNT(*) FROM kompetensi_keahlian")->fetchColumn();
    if ($countKomp === 0) {
        $komps = [
            'Rekayasa Perangkat Lunak (RPL)',
