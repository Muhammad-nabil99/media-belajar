function runSeed(): void {
    echo "\n\033[1;34m=== Menjalankan Database Seeding Media Belajar ===\033[0m\n\n";

    try {
        $db = getDB();
    } catch (\Throwable $e) {
        printError("Gagal terhubung ke database: " . $e->getMessage());
        exit(1);
    }

    $backupFile = __DIR__ . '/backup.sql';

    // Jika ada backup.sql, utamakan mengimpor data lengkap dari backup.sql
    if (file_exists($backupFile)) {
        printInfo("Ditemukan berkas cadangan 'backup.sql' (" . round(filesize($backupFile) / 1024 / 1024, 2) . " MB).");
        printInfo("Mengimpor data produksi dari backup.sql...");

        $imported = false;
        $host = DB_HOST;
        $port = DB_PORT;
        $dbname = DB_NAME;
        $user = DB_USER;
        $pass = DB_PASS;

        // Coba import via mariadb / mysql CLI
        $cmd = sprintf(
            'mariadb -h %s -P %s -u %s -p%s %s < %s 2>&1',
            escapeshellarg($host),
            escapeshellarg($port),
            escapeshellarg($user),
            escapeshellarg($pass),
            escapeshellarg($dbname),
            escapeshellarg($backupFile)
        );
        $output = [];
        $ret = -1;
        @exec($cmd, $output, $ret);

        if ($ret !== 0) {
            $cmdMysql = sprintf(
                'mysql -h %s -P %s -u %s -p%s %s < %s 2>&1',
                escapeshellarg($host),
                escapeshellarg($port),
                escapeshellarg($user),
                escapeshellarg($pass),
                escapeshellarg($dbname),
                escapeshellarg($backupFile)
            );
            @exec($cmdMysql, $output, $ret);
        }

        if ($ret === 0) {
            $imported = true;
            printSuccess("Berhasil mengimpor seluruh data dari backup.sql ke database!");
        } else {
            // Fallback: jalankan batch per statement menggunakan PDO
            try {
                $sqlContent = file_get_contents($backupFile);
                $db->setAttribute(PDO::ATTR_EMULATE_PREPARES, 1);
                $db->exec($sqlContent);
                $imported = true;
                printSuccess("Berhasil mengimpor seluruh data dari backup.sql via PDO.");
            } catch (\Throwable $t) {
                printWarn("Import via script menemui kendala: " . $t->getMessage());
                printInfo("Anda dapat mengimpor langsung dengan: docker exec -i media-belajar-db mariadb -u media_user -pmedia_password_rahasia media_belajar < backup.sql");
            }
        }

        // Terapkan migrasi tabel baru (settings & audit logs) di atas data backup
        ensureRegistrationTables($db);
        printSuccess("Sinkronisasi tabel fitur pengaturan pendaftaran selesai.");

        echo "\n\033[32m✔ Pemulihan database dari backup.sql selesai dengan sukses!\033[0m\n\n";
        return;
    }

    // Pastikan tabel sudah terbentuk terlebih dahulu jika tidak ada backup.sql
    runMigrate();

    // 1. Seed Akun Default (Admin, Reviewer, Kontributor)
    $users = [
        [
            'email'     => 'admin@btikpsultra.com',
            'password'  => 'admin123',
            'full_name' => 'Administrator BTIKP Sultra',
            'instansi'  => 'BTIKP Dinas Pendidikan dan Kebudayaan Sulawesi Tenggara',
            'role'      => 'admin',
        ],
        [
            'email'     => 'reviewer@btikpsultra.com',
            'password'  => 'reviewer123',
            'full_name' => 'Tim Kurator & Reviewer Media',
            'instansi'  => 'BTIKP Sultra',
            'role'      => 'reviewer',
        ],
        [
            'email'     => 'guru@btikpsultra.com',
            'password'  => 'guru123',
            'full_name' => 'Guru Kontributor Sultra',
            'instansi'  => 'SMA Negeri 1 Kendari',
            'role'      => 'kontributor',
        ]
    ];

    foreach ($users as $u) {
        $stCheck = $db->prepare("SELECT id FROM users WHERE email = ? LIMIT 1");
        $stCheck->execute([$u['email']]);
        $existingId = $stCheck->fetchColumn();

        if ($existingId) {
            printInfo("Akun {$u['email']} sudah ada (Dilewati).");
        } else {
            $userId = uuid4();
            $hash = password_hash($u['password'], PASSWORD_BCRYPT);

            $db->prepare("INSERT INTO users (id, email, encrypted_password, full_name, email_confirmed_at) VALUES (?, ?, ?, ?, NOW())")
               ->execute([$userId, $u['email'], $hash, $u['full_name']]);

            $db->prepare("INSERT INTO profiles (id, full_name, instansi) VALUES (?, ?, ?)")
               ->execute([$userId, $u['full_name'], $u['instansi']]);

            $db->prepare("INSERT INTO user_roles (id, user_id, role) VALUES (?, ?, ?)")
               ->execute([uuid4(), $userId, $u['role']]);

            printSuccess("Akun default dibuat: {$u['email']} (Peran: {$u['role']})");
        }
    }

    // 2. Seed Data Mata Pelajaran
    $countMapel = (int)$db->query("SELECT COUNT(*) FROM mata_pelajaran")->fetchColumn();
    if ($countMapel === 0) {
        $mapels = [
            ['jenjang' => 'SD', 'nama' => 'Pendidikan Pancasila', 'urutan' => 1],
            ['jenjang' => 'SD', 'nama' => 'Bahasa Indonesia', 'urutan' => 2],
