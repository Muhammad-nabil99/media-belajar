        'mata_pelajaran' => "CREATE TABLE IF NOT EXISTS `mata_pelajaran` (
            `id` INT AUTO_INCREMENT PRIMARY KEY,
            `jenjang` VARCHAR(50) NOT NULL,
            `nama` VARCHAR(150) NOT NULL,
            `urutan` INT DEFAULT 1,
